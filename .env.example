# Dietary Guidance RAG Chatbot Environment Variables

# LLM Configuration (Groq / Gemini)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Alternative Groq model: qwen/qwen3.6-27b

# Google Gemini API (Legacy / Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embeddings & Vector Store
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=data/vectordb
SIMILARITY_THRESHOLD=0.53
RETRIEVAL_TOP_K=6

# Paths
DATA_BLOCKS_PATH=data/blocks.jsonl
CORPUS_REGISTRY_PATH=config/corpus_registry.yaml

# API Gateway
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
ENVIRONMENT=development
DEBUG=false
